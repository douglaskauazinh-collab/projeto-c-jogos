}

/* [R35] Vitoria */
static void show_victory(void)
{
    clear_screen();
    printf("========================================\n");
    printf("           VITORIA! PARABENS!           \n");
    printf("========================================\n\n");
    printf("Com um ultimo golpe, ZOTHRAK se desfaz\n");
    printf("em sombras. O cristal negro explode em\n");
    printf("luz dourada, purificando a masmorra.\n\n");
    printf("Voce emerge sob o ceu de Aeloria,\n");
    printf("mais azul do que nunca.\n\n");
    printf("Uma crianca grita:\n");
    printf("  \"O guardiao voltou! O guardiao voltou!\"\n\n");
    printf("A paz foi restaurada.\n");
    printf("Sua lenda sera cantada por geracoes.\n\n");
    printf("              FIM\n\n");
    press_enter();
}

/* [R08] Game Over */
static void show_gameover(void)
{
    clear_screen();
    printf("========================================\n");
    printf("              GAME OVER                 \n");
    printf("========================================\n\n");
    printf("As trevas te consumiram...\n");
    printf("ZOTHRAK ri nas profundezas.\n\n");
    printf("Mas toda lenda tem uma segunda chance.\n\n");
    press_enter();
}

/* ============================================================
 *  LOOP DO JOGO
 * ============================================================ */
static void game_loop(void)
{
    char input;
    render_game();

    while (game_running &&
           current_phase >= PHASE_VILA &&
           current_phase <= PHASE_FLOOR3)
    {
        printf("\n> ");
        fflush(stdout);
        input = get_char();

        switch (input) {
            case 'w': move_player(-1,  0, DIR_UP);    break;
            case 's': move_player( 1,  0, DIR_DOWN);  break;
            case 'a': move_player( 0, -1, DIR_LEFT);  break;
            case 'd': move_player( 0,  1, DIR_RIGHT); break;
            case 'i': do_interact(); break;
            case 'o': do_attack();   break;
            case 'q':
                printf("Deseja sair? (s/n): ");
                fflush(stdout);
                if (get_char() == 's') { game_running = 0; return; }
                break;
            default:
                printf("[Tecla invalida. Use w/a/s/d/i/o/q]\n");
                break;
        }

        if (current_phase >= PHASE_FLOOR1 && current_phase <= PHASE_FLOOR3)
            update_monsters();

        if (current_phase == PHASE_GAMEOVER || current_phase == PHASE_WIN)
            break;

        render_game();
    }
}

/* ============================================================
 *  MENU PRINCIPAL [R12-R14]
 * ============================================================ */
static void show_menu(void)
{
    char c;
    while (1) {
        clear_screen();
        printf("========================================\n");
        printf("         A LENDA DAS TREVAS             \n");
        printf("       Dungeon Crawler em C             \n");
        printf("========================================\n\n");
        printf("  1. Jogar\n");
        printf("  2. Tutorial\n");
        printf("  3. Sair\n\n");
        printf("Escolha: ");
        fflush(stdout);
        c = get_char();

        switch (c) {
            case '1':
                current_phase = PHASE_VILA;
                build_vila();
                game_running = 1;
                game_loop();
                if      (current_phase == PHASE_WIN)     show_victory();
                else if (current_phase == PHASE_GAMEOVER) show_gameover();
                break;
            case '2':
                show_tutorial();
                break;
            case '3':
                show_credits();
                return;
            default:
                printf("[Opcao invalida]\n");
                press_enter();
        }
    }
}

/* ============================================================
 *  MAIN
 * ============================================================ */
int main(void)
{
    srand((unsigned int)time(NULL));
    current_phase = PHASE_MENU;
    game_running  = 0;
    show_menu();
    printf("Ate a proxima aventura!\n");
    return 0;
}
