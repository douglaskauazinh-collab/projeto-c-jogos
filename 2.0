                m->orbit_phase = 1;
                m->dash_timer  = 0;
            }
        }
    } else {
        /* Fase dash: move 2 celulas em direcao ao jogador */
        for (step = 0; step < 2; step++) {
            dr = player.row - m->row;
            dc = player.col - m->col;
            nr = m->row;
            nc = m->col;
            if (abs_val(dr) >= abs_val(dc) && dr != 0)
                nr = m->row + (dr > 0 ? 1 : -1);
            else if (dc != 0)
                nc = m->col + (dc > 0 ? 1 : -1);
            else break;
            if (in_bounds(nr, nc) && gmap.grid[nr][nc] != SYM_WALL) {
                m->row = nr;
                m->col = nc;
            }
        }
        m->orbit_phase = 0;
    }
}

static void update_monsters(void)
{
    int i;
    Monster *m;
    for (i = 0; i < gmap.num_monsters; i++) {
        m = &gmap.monsters[i];
        if (!m->alive) continue;
        switch (m->type) {
            case SYM_MON1: move_monster_type1(m); break;
            case SYM_MON2: move_monster_type2(m); break;
            case SYM_BOSS: move_boss(m);          break;
        }
        if (m->alive && m->row == player.row && m->col == player.col) {
            player.lives--;
            printf("[Monstro te atingiu! Vidas: %d]\n", player.lives);
            if (player.lives <= 0) current_phase = PHASE_GAMEOVER;
            else restore_phase_state();
            press_enter();
            return;
        }
    }
}

/* ============================================================
 *  TELAS ESPECIAIS
 * ============================================================ */

/* [R13] Tutorial */
static void show_tutorial(void)
{
    clear_screen();
    printf("=== TUTORIAL - A LENDA DAS TREVAS ===\n\n");
    printf("HISTORIA:\n");
    printf("O reino de Aeloria foi corrompido por ZOTHRAK,\n");
    printf("um ser antigo que dorme na Masmorra Esquecida.\n");
    printf("Voce, o ultimo guardiao, deve descer e derrotá-lo.\n\n");
    printf("SIMBOLOS:\n");
    printf("  < ^ > v = Jogador (direcao que esta olhando)\n");
    printf("  *       = Parede\n");
    printf("  #       = Espinho (mata ao pisar)\n");
    printf("  k       = Caixa (destrua com ataque)\n");
    printf("  O       = Botao (pressione com 'i')\n");
    printf("  D       = Porta fechada (use chave)\n");
    printf("  =       = Porta aberta\n");
    printf("  @       = Chave (colete com 'i')\n");
    printf("  L       = Escada (proximo andar)\n");
    printf("  N       = NPC\n");
    printf("  E       = Entrada da masmorra\n");
    printf("  X       = Monstro Tipo 1 (aleatorio)\n");
    printf("  Y       = Monstro Tipo 2 (persegue voce)\n");
    printf("  Z       = Boss Final\n\n");
    printf("CONTROLES:\n");
    printf("  w/a/s/d = Mover\n");
    printf("  i       = Interagir\n");
    printf("  o       = Atacar\n");
    printf("  q       = Sair\n\n");
    printf("ARMAS:\n");
    printf("  Espada        = Regiao 3x2 a frente\n");
    printf("  Arco e Flecha = 4 celulas em linha reta\n");
    printf("  Cajado        = 8 celulas ao redor\n\n");
    press_enter();
}

/* [R14] Creditos */
