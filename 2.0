{
    clear_screen();
    printf("=== CREDITOS ===\n\n");
    printf("A LENDA DAS TREVAS\n");
    printf("Dungeon Crawler em C (ANSI C89)\n\n");
    printf("Desenvolvido para a disciplina de\n");
    printf("Algoritmos e Estruturas de Dados.\n\n");
